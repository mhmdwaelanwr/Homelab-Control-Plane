{
  "name": "linux-dashboard-suite",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @dash/server\" \"npm run dev -w @dash/web\"",
    "dev:web": "npm run dev -w @dash/web",
    "dev:server": "npm run dev -w @dash/server",
    "build": "npm run build -w @dash/server && npm run build -w @dash/web",
    "lint": "npm run lint -w @dash/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
