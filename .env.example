# Required local admin credentials
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional read-only viewer account. Leave both empty to disable viewer login.
VIEWER_USER=
VIEWER_PASSWORD=

# Managed filesystem root. Use a narrow directory instead of / for real deployments.
DASH_ROOT=/srv/homelab

# API / frontend origins
PORT=4000
CORS_ORIGIN=http://localhost:5173

# WebSocket metrics auth should be enabled before remote/LAN exposure.
WS_REQUIRE_AUTH=true
METRICS_BROADCAST_MS=2000

# File / terminal limits
MAX_UPLOAD_BYTES=26214400
TERMINAL_COMMAND_TIMEOUT_MS=20000

# Optional screen-sharing gateway
SCREEN_PROVIDER=novnc
SCREEN_EMBED_URL=http://localhost:6080/vnc.html
SCREEN_WEBSOCKET_URL=ws://localhost:6080/websockify
SCREEN_DISPLAY_NAME=:0
SCREEN_CONNECTION_TYPE=noVNC gateway
